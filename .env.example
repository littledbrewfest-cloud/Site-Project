# Database (SQLite file)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=""

# Unsplash API Access Key (Optional for high-res topic images; fallback works automatically if blank)
UNSPLASH_ACCESS_KEY=""

# Admin Dashboard Password (Used to log into /admin)
ADMIN_PASSWORD="change_this_to_a_secure_password"

# Cron API Secret (Used to authenticate automated requests to /api/cron/generate)
CRON_SECRET="generate_a_random_secure_cron_token"

# Public site URL (Used for Canonical URLs, OpenGraph, Sitemap, RSS)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
